{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "noEmitOnError": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/room-demo.ts",
    "vendor/**/*.js",
    "tests/game/**/*.ts",
    "vitest.config.ts"
  ]
}
